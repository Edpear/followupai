{
  "name": "followupai",
  "version": "1.1.5",
  "description": "Generate follow-up questions using Groq API with structured JSON output",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "node dist/index.js",
    "setup": "node dist/setup.js",
    "demo": "node dist/demo-server.js",
    "test": "jest",
    "prepare": "npm run build"
  },
  "keywords": [
    "groq",
    "ai",
    "questions",
    "quiz",
    "follow-up",
    "api"
  ],
  "author": "followupai Team",
  "license": "MIT",
  "dependencies": {
    "axios": "^1.6.0",
    "dotenv": "^16.3.1",
    "inquirer": "^9.2.12",
    "express": "^4.18.2",
    "cors": "^2.8.5",
    "commander": "^11.1.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@types/node": "^20.8.0",
    "@types/express": "^4.17.20",
    "@types/cors": "^2.8.15",
    "@types/inquirer": "^9.0.7",
    "typescript": "^5.2.2",
    "jest": "^29.7.0",
    "@types/jest": "^29.5.6"
  },
  "bin": {
    "followupai": "./dist/cli.js"
  },
  "prepublishOnly": "npm run build",
  "files": [
    "dist",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/yourusername/followupai.git"
  },
  "engines": {
    "node": ">=16.0.0"
  }
} 